{
  "name": "@fitch/pi-pstack",
  "version": "0.15.29",
  "private": true,
  "description": "Pi package adapter for Cursor pstack skills, playbooks, principles, and subagent profiles with automated upstream drift notifications.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-pstack.git"
  },
  "keywords": [
    "pi-package",
    "pstack",
    "poteto-mode",
    "agent-skills",
    "subagents"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.js"
    ],
    "skills": [
      "./skills"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "subagents": {
    "agents": [
      "./agents"
    ]
  },
  "scripts": {
    "sync": "node scripts/sync-pstack.mjs --fetch",
    "check:sync": "node scripts/sync-pstack.mjs --check",
    "test": "node --test test/*.test.mjs",
    "smoke": "node --test test/discovery.test.mjs",
    "check:compat": "npm run check:sync && npm test && npm run pack:check",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
