@@ -0,0 +1,218 @@
+// Read-only GitHub queries for the watcher, built on the shared gh-client.
+// Every REST read names the commit it is about, so one poll never mixes two heads.
+
+import { basename } from "node:path";
+import { QueryError, createGhClient, login, readTogether, segment } from "./gh-client.mjs";
+import { normalizeThread } from "./threads.mjs";
+
+export { QueryError, login, readTogether };
+
+const PULL_REQUEST = `query($owner:String!,$repo:String!,$number:Int!,$endCursor:String){
+  repository(owner:$owner,name:$repo){pullRequest(number:$number){
+    url state isDraft mergedAt mergeable mergeStateStatus reviewDecision headRefOid baseRefName
+    mergeCommit{oid}
+    reviewThreads(first:100,after:$endCursor){
+      pageInfo{hasNextPage endCursor}
+      nodes{
+        id isResolved isOutdated path line originalLine
+        comments(first:20){
+          nodes{
+            id fullDatabaseId commit{oid} originalCommit{oid} author{login} body url createdAt outdated
+          }
+        }
+      }
+    }
+  }}
+}`;
+const HEAD = `query($owner:String!,$repo:String!,$number:Int!){
+  repository(owner:$owner,name:$repo){pullRequest(number:$number){headRefOid}}
+}`;
+const WORKFLOWS = `query($owner:String!,$repo:String!,$expression:String!){
+  repository(owner:$owner,name:$repo){object(expression:$expression){
+    ... on Tree{entries{name type object{... on Blob{text}}}}
+  }}
+}`;
+
+// Check run and workflow run conclusions:
+// https://docs.github.com/en/rest/checks/runs#get-a-check-run
+const PASSED = new Set(["success"]);
+const SKIPPED = new Set(["neutral", "skipped"]);
+/** State of a check run or workflow run from its `status` and `conclusion`. */
+function stateOf({ status, conclusion }) {
+  if (status !== "completed") return "pending";
+  return PASSED.has(conclusion) ? "passed" : SKIPPED.has(conclusion) ? "skipped" : "failed";
+}
+
+/**
+ * @param {string | ReturnType<typeof createGhClient>} executableOrClient
+ * @param {{ env?: NodeJS.ProcessEnv }} [options]
+ */
+export function createGitHub(executableOrClient, options) {
+  const client = typeof executableOrClient === "string"
+    ? createGhClient(executableOrClient, options)
+    : executableOrClient;
+
+  function pullRequestNode(page, pr) {
+    const node = page?.data?.repository?.pullRequest;
+    if (!node) throw new QueryError(`GitHub returned no pull request for ${pr.owner}/${pr.repo}#${pr.number}`);
+    return node;
+  }
+
+  return {
+    /** State of the pull request and its review threads, in one snapshot per page. */
+    async pullRequest(pr) {
+      const pages = await client.graphql(PULL_REQUEST, pr, { paginate: true });
+      const nodes = pages.map((page) => pullRequestNode(page, pr));
+      const last = nodes.at(-1);
+      const head = last.headRefOid;
+      const allThreads = nodes
+        .flatMap((node) => node.reviewThreads.nodes)
+        .map((thread) => normalizeThread(thread, head));
+      return {
+        url: last.url,
+        state: last.state,
+        isDraft: last.isDraft,
+        mergedAt: last.mergedAt,
+        mergeCommit: last.mergeCommit?.oid ?? null,
+        mergeable: last.mergeable,
+        mergeState: last.mergeStateStatus,
+        reviewDecision: last.reviewDecision || null,
+        head,
+        baseRef: last.baseRefName,
+        threads: allThreads.filter((thread) => !thread.isResolved),
+        allThreads,
+      };
+    },
+
+    async head(pr) {
+      return pullRequestNode(await client.graphql(HEAD, pr), pr).headRefOid;
+    },
+
+    /**
+     * Checks and workflow runs on one commit.
+     *
+     * Reads the commit, not the pull request: the pull request's check list
+     * omits runs started by workflow_dispatch on the same commit.
+     * https://docs.github.com/en/rest/checks/runs#list-check-runs-for-a-git-reference
+     * https://docs.github.com/en/rest/commits/statuses#get-the-combined-status-for-a-specific-reference
+     * https://docs.github.com/en/rest/actions/workflow-runs#list-workflow-runs-for-a-repository
+     */
+    async commitChecks(pr, sha) {
+      const base = `repos/${pr.owner}/${pr.repo}`;
+      const [checkPages, statusPages, runPages] = await readTogether([
+        client.rest(`${base}/commits/${sha}/check-runs?per_page=100`),
+        client.rest(`${base}/commits/${sha}/status?per_page=100`),
+        client.rest(`${base}/actions/runs?head_sha=${sha}&per_page=100`),
+      ]);
+      const runs = runPages.flatMap((page) => page.workflow_runs).map((run) => ({
+        id: run.id, name: run.name ?? null, path: run.path, event: run.event, suite: run.check_suite_id,
+        status: run.status, conclusion: run.conclusion, link: run.html_url,
+      }));
+      const bySuite = new Map(runs.map((run) => [run.suite, run]));
+      const runKey = (run) => `${run.path} ${run.event}`;
+      const latestRun = new Map();
+      for (const run of runs) {
+        if (!latestRun.has(runKey(run)) || latestRun.get(runKey(run)).id < run.id) latestRun.set(runKey(run), run);
+      }
+      // A workflow can run again on the same commit and event: a cancelled run,
+      // a reopened pull request, a label. The runs can hold different jobs, so
+      // every job name counts, with its newest check.
+      const newest = new Map();
+      for (const check of checkPages.flatMap((page) => page.check_runs)) {
+        const run = bySuite.get(check.check_suite?.id);
+        const key = `${run ? runKey(run) : `suite ${check.check_suite?.id}`}\n${check.name}`;
+        const previous = newest.get(key);
+        if (!previous || previous.id < check.id) newest.set(key, check);
+      }
+      const checks = [...newest.values()]
+        // The check of an earlier run is not final while a later run of the same workflow is unfinished.
+        .filter((check) => {
+          const run = bySuite.get(check.check_suite?.id);
+          return !run || latestRun.get(runKey(run)) === run || latestRun.get(runKey(run)).status === "completed";
+        })
+        .map((check) => {
+          const run = bySuite.get(check.check_suite?.id);
+          return {
+            name: check.name,
+            workflow: run?.name ?? null,
+            state: stateOf(check),
+            detail: check.status !== "completed" ? check.status : check.conclusion,
+            link: check.details_url || check.html_url || "",
+            suite: check.check_suite?.id,
+          };
+        });
+      // A workflow run exists before its jobs do. GitHub creates a job that
+      // needs another job only when that job ends, and a run can end without
+      // any job (approval required, invalid workflow file). So an unfinished
+      // run, and a latest run that did not succeed, count even when no check says so.
+      for (const run of runs) {
+        const state = stateOf(run);
+        const counts = state === "pending" || (state === "failed" && latestRun.get(runKey(run)) === run);
+        if (!counts || checks.some((check) => check.suite === run.suite && check.state === state)) continue;
+        checks.push({
+          name: `workflow ${basename(run.path)}`,
+          workflow: run.name ?? null,
+          state,
+          detail: run.status !== "completed" ? run.status : run.conclusion,
+          link: run.link,
+        });
+      }
+      for (const status of statusPages.flatMap((page) => page.statuses)) {
+        checks.push({
+          name: status.context,
+          workflow: null,
+          state: status.state === "success" ? "passed" : status.state === "pending" ? "pending" : "failed",
+          detail: status.state,
+          link: status.target_url || "",
+        });
+      }
+      return { checks, runs };
+    },
+
+    /** Workflow files in the tree of one commit: `[{ path, text }]`; text is null when GitHub returns none. */
+    async workflowFiles(pr, sha) {
+      const result = await client.graphql(WORKFLOWS, { owner: pr.owner, repo: pr.repo, expression: `${sha}:.github/workflows` });
+      if (!result?.data?.repository) throw new QueryError(`GitHub returned no repository for ${pr.owner}/${pr.repo}`);
+      return (result.data.repository.object?.entries ?? [])
+        .filter((entry) => entry.type === "blob" && /\.ya?ml$/.test(entry.name))
+        .map((entry) => ({ path: `.github/workflows/${entry.name}`, text: entry.object?.text ?? null }));
+    },
+
+    /**
+     * Names of the status checks GitHub requires before merging into `baseRef`,
+     * from rulesets and from classic branch protection.
+     * https://docs.github.com/en/rest/repos/rules#get-rules-for-a-branch
+     * https://docs.github.com/en/rest/branches/branches#get-a-branch
+     */
+    async requiredChecks(pr, baseRef) {
+      const base = `repos/${pr.owner}/${pr.repo}`;
+      const [rulePages, branchPages] = await readTogether([
+        client.rest(`${base}/rules/branches/${segment(baseRef)}?per_page=100`),
+        client.rest(`${base}/branches/${segment(baseRef)}`),
+      ]);
+      const names = rulePages.flat().filter((rule) => rule.type === "required_status_checks")
+        .flatMap((rule) => rule.parameters.required_status_checks.map((check) => check.context));
+      const classic = branchPages[0]?.protection?.required_status_checks;
+      if (classic && classic.enforcement_level !== "off") names.push(...(classic.contexts ?? []));
+      return [...new Set(names)];
+    },
+
+    /**
+     * Text that reviewers left on the pull request, newest first: issue comments
+     * and review bodies. A review names its commit; a comment does not.
+     */
+    async reviewTexts(pr) {
+      const base = `repos/${pr.owner}/${pr.repo}`;
+      const [commentPages, reviewPages] = await readTogether([
+        client.rest(`${base}/issues/${pr.number}/comments?per_page=100`),
+        client.rest(`${base}/pulls/${pr.number}/reviews?per_page=100`),
+      ]);
+      return [
+        ...commentPages.flat().map((comment) => (
+          { author: login(comment.user?.login), body: comment.body ?? "", at: comment.updated_at, commit: null })),
+        ...reviewPages.flat().map((review) => (
+          { author: login(review.user?.login), body: review.body ?? "", at: review.submitted_at, commit: review.commit_id })),
+      ].sort((a, b) => (a.at < b.at ? 1 : -1));
+    },
+  };
+}
diff --git a/skills/watch-pr/scripts/pr-threads.mjs b/skills/watch-pr/scripts/pr-threads.mjs
new file mode 100755
index 0000000000000000000000000000000000000000..2e6be605b6b0fba655dfc85c08816c82098faaff
--- /dev/null
+++ b/skills/watch-pr/scripts/pr-threads.mjs
@@ -0,0 +1,213 @@
+#!/usr/bin/env node
+// Lists, replies to, and resolves GitHub pull request review threads using the
+// shared watch-pr repository config and gh-client routing.
+
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+import { parseArgs } from "node:util";
+import { QueryError, createGhClient, formatRateLimit } from "./gh-client.mjs";
+import { createGitHub } from "./github.mjs";
+import {
+  ConfigError,
+  configPath,
+  loadConfig,
+  parsePrTarget,
+  resolveGitHubCli,
+  resolveRepo,
+  settingsFor,
+} from "./repo-config.mjs";
+import { formatThreadList } from "./threads.mjs";
+import { EXIT } from "./verdict.mjs";
+
+const USAGE = `Usage: pr-threads.mjs [<number|url>] [--repo OWNER/NAME] [--list] [--all] [--json]
+       pr-threads.mjs [<number|url>] [--repo OWNER/NAME] --reply <threadId> --body-file <path>
+       pr-threads.mjs [<number|url>] [--repo OWNER/NAME] --resolve <threadId>
+
+Lists unresolved PR review threads or replies to / resolves a thread through the
+repository's configured GitHub CLI (watch-pr.json / WATCH_PR_GH).
+
+  <number|url>        pull request number or URL (required for --list; optional for --reply/--resolve
+                      when --repo or the origin remote identifies the repository)
+  --repo              OWNER/NAME; default: the origin remote (also --owner OWNER --repo NAME)
+  --list              list unresolved review threads (default when a PR is given with no mutation)
+  --all               with --list, include resolved threads as well
+  --json              with --list, print structured JSON
+  --reply THREAD_ID   post a reply to this review thread (requires --body-file)
+  --body-file PATH    UTF-8 file containing the reply body (use "-" to read stdin)
+  --resolve THREAD_ID mark this review thread as resolved
+
+Exit: 0 success, 7 GitHub query failed, 64 usage or configuration error.
+`;
+
+const REPLY_MUTATION = `mutation($threadId:ID!,$body:String!){
+  addPullRequestReviewThreadReply(input:{pullRequestReviewThreadId:$threadId,body:$body}){
+    comment{id fullDatabaseId url createdAt author{login}}
+  }
+}`;
+
+const RESOLVE_MUTATION = `mutation($threadId:ID!){
+  resolveReviewThread(input:{threadId:$threadId}){
+    thread{id isResolved}
+  }
+}`;
+
+class UsageError extends Error {}
+
+function readBodyFile(path) {
+  let content;
+  try {
+    content = path === "-" ? readFileSync(0, "utf8") : readFileSync(path, "utf8");
+  } catch (error) {
+    throw new UsageError(`cannot read --body-file "${path}": ${error.message}`);
+  }
+  if (!content.trim()) throw new UsageError("--body-file must not be empty");
+  return content;
+}
+
+async function parse(argv) {
+  let parsed;
+  try {
+    parsed = parseArgs({
+      args: argv,
+      allowPositionals: true,
+      options: {
+        repo: { type: "string" },
+        owner: { type: "string" },
+        pr: { type: "string" },
+        list: { type: "boolean", default: false },
+        all: { type: "boolean", default: false },
+        json: { type: "boolean", default: false },
+        reply: { type: "string" },
+        "body-file": { type: "string" },
+        resolve: { type: "string" },
+        help: { type: "boolean", short: "h", default: false },
+      },
+    });
+  } catch (error) {
+    throw new UsageError(error.message);
+  }
+  const { values, positionals } = parsed;
+  if (values.help) return null;
+  if (positionals.length > 1) throw new UsageError("name at most one pull request");
+  if (positionals.length && values.pr !== undefined) throw new UsageError("name the pull request once");
+  const target = positionals[0] ?? values.pr;
+
+  const replyId = values.reply?.trim();
+  const resolveId = values.resolve?.trim();
+  if (values.reply !== undefined && !replyId) throw new UsageError("--reply requires a non-empty thread ID");
+  if (values.resolve !== undefined && !resolveId) throw new UsageError("--resolve requires a non-empty thread ID");
+  if (replyId && !values["body-file"]) throw new UsageError("--reply requires --body-file <path>");
+  if (!replyId && values["body-file"] !== undefined) throw new UsageError("--body-file can only be used with --reply");
+
+  const hasMutation = Boolean(replyId || resolveId);
+  const doList = values.list || (!hasMutation && target !== undefined);
+  if (!doList && !hasMutation) {
+    throw new UsageError("specify --list <number|url>, --reply <threadId> --body-file <path>, or --resolve <threadId>");
+  }
+  if (doList && target === undefined) throw new UsageError("--list requires a pull request number or URL");
+
+  let pr = null;
+  let repoTarget = null;
+  if (target !== undefined) {
+    const resolved = await parsePrTarget(target, { owner: values.owner, repo: values.repo });
+    if (resolved.error) throw new UsageError(resolved.error);
+    pr = resolved.pr;
+    repoTarget = { owner: pr.owner, repo: pr.repo };
+  } else {
+    repoTarget = await resolveRepo({ owner: values.owner, repo: values.repo });
+    if (!repoTarget) throw new UsageError("name the repository: --repo OWNER/NAME");
+  }
+
+  return {
+    pr,
+    repo: repoTarget,
+    list: doList,
+    all: values.all,
+    json: values.json,
+    replyId: replyId ?? null,
+    bodyFile: values["body-file"] ?? null,
+    resolveId: resolveId ?? null,
+  };
+}
+
+/** Posts a reply to one review thread via GraphQL. */
+export async function replyToThread(client, threadId, body) {
+  const result = await client.graphql(REPLY_MUTATION, { threadId, body });
+  const comment = result?.data?.addPullRequestReviewThreadReply?.comment;
+  if (!comment) throw new QueryError(`GitHub returned no comment when replying to thread ${threadId}`);
+  return comment;
+}
+
+/** Marks one review thread as resolved via GraphQL. */
+export async function resolveThread(client, threadId) {
+  const result = await client.graphql(RESOLVE_MUTATION, { threadId });
+  const thread = result?.data?.resolveReviewThread?.thread;
+  if (!thread || !thread.isResolved) {
+    throw new QueryError(`GitHub did not confirm resolution of thread ${threadId}`);
+  }
+  return thread;
+}
+
+async function main(argv, env) {
+  const options = await parse(argv);
+  if (options === null) {
+    process.stdout.write(USAGE);
+    return 0;
+  }
+  const body = options.replyId ? readBodyFile(options.bodyFile) : null;
+  const settingsPath = configPath(env);
+  const settings = settingsFor(loadConfig(settingsPath), options.repo.owner, options.repo.repo);
+  const { executable, source } = resolveGitHubCli(settings, { env, settingsPath });
+  const client = createGhClient(executable, { env });
+  const github = createGitHub(client);
+
+  try {
+    if (options.replyId) {
+      const comment = await replyToThread(client, options.replyId, body);
+      process.stdout.write(`replied: ${options.replyId} -> ${comment.url ?? comment.id}\n`);
+    }
+    if (options.resolveId) {
+      await resolveThread(client, options.resolveId);
+      process.stdout.write(`resolved: ${options.resolveId}\n`);
+    }
+    if (options.list) {
+      const facts = await github.pullRequest(options.pr);
+      const threads = options.all ? facts.allThreads : facts.threads;
+      if (options.json) {
+        process.stdout.write(`${JSON.stringify({
+          pr: facts.url,
+          head: facts.head,
+          unresolvedCount: facts.threads.length,
+          threads,
+        }, null, 2)}\n`);
+      } else {
+        process.stdout.write(formatThreadList({
+          url: facts.url,
+          head: facts.head,
+          threads,
+          includeResolved: options.all,
+        }));
+      }
+    }
+    return 0;
+  } catch (error) {
+    if (!(error instanceof QueryError)) throw error;
+    const reason = error.rateLimit ? formatRateLimit(error.rateLimit) : error.message;
+    process.stderr.write([
+      `pr-threads: GitHub query failed: ${reason}`,
+      `github cli: ${executable} (${source})`,
+    ].join("\n").concat("\n"));
+    return EXIT.queryFailed;
+  }
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
+  try {
+    process.exitCode = await main(process.argv.slice(2), process.env);
+  } catch (error) {
+    if (!(error instanceof UsageError) && !(error instanceof ConfigError)) throw error;
+    process.stderr.write(`pr-threads: ${error.message}\n${error instanceof UsageError ? USAGE : ""}`);
+    process.exitCode = EXIT.usage;
+  }
+}
diff --git a/skills/watch-pr/scripts/repo-config.mjs b/skills/watch-pr/scripts/repo-config.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..16f8199712624824b759024b59b6163b4a7c62a4
--- /dev/null
+++ b/skills/watch-pr/scripts/repo-config.mjs
@@ -0,0 +1,173 @@
+// Shared repository configuration and GitHub CLI routing for watch-pr tools
+// (`watch-pr.mjs`, `pr-threads.mjs`, and future `watch-run.mjs`).
+
+import { execFile } from "node:child_process";
+import { readFileSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+export class ConfigError extends Error {}
+
+const ALLOWED_KEYS = new Set(["gh", "reviewers", "mergeWithoutApproval"]);
+
+/** `WATCH_PR_CONFIG`, or `watch-pr.json` in the Pi agent directory. */
+export function configPath(env = process.env) {
+  if (env.WATCH_PR_CONFIG) return env.WATCH_PR_CONFIG;
+  const agent = env.PI_CODING_AGENT_DIR;
+  const directory = !agent ? join(homedir(), ".pi", "agent")
+    : agent === "~" ? homedir() : agent.startsWith("~/") ? join(homedir(), agent.slice(2)) : agent;
+  return join(directory, "watch-pr.json");
+}
+
+function fail(path, message) {
+  throw new ConfigError(`${path}: ${message}`);
+}
+
+function pattern(path, where, value) {
+  let regex;
+  try {
+    regex = new RegExp(value);
+  } catch (error) {
+    fail(path, `${where} is not a valid regular expression: ${error.message}`);
+  }
+  if (new RegExp(`${value}|`).exec("").length !== 2) fail(path, `${where} must have exactly one capture group`);
+  return regex;
+}
+
+function reviewer(path, where, value) {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) fail(path, `${where} must be an object`);
+  const keys = Object.keys(value).sort().join(",");
+  const text = (key) => {
+    if (typeof value[key] !== "string" || !value[key]) fail(path, `${where}.${key} must be a non-empty string`);
+    return value[key];
+  };
+  if (keys === "check,name") return { name: text("name"), check: text("check") };
+  if (keys === "author,commit,name,pass,verdict") {
+    return {
+      name: text("name"),
+      author: text("author"),
+      verdict: pattern(path, `${where}.verdict`, text("verdict")),
+      pass: text("pass"),
+      commit: pattern(path, `${where}.commit`, text("commit")),
+    };
+  }
+  return fail(path, `${where} must have the keys name and check, or name, author, verdict, pass and commit`);
+}
+
+/**
+ * Reads the settings file. A missing file is an empty configuration.
+ *
+ * The file is a JSON object. Each key is `*` (every repository), an owner, or
+ * `owner/repository`. Each value may hold `gh` (the GitHub CLI executable),
+ * `reviewers` (a list of rules), and `mergeWithoutApproval` (true or false).
+ * Unknown keys are rejected: a misspelled rule must not be silently dropped.
+ */
+export function loadConfig(path) {
+  let text;
+  try {
+    text = readFileSync(path, "utf8");
+  } catch (error) {
+    if (error.code === "ENOENT") return new Map();
+    throw new ConfigError(`${path}: ${error.message}`);
+  }
+  let parsed;
+  try {
+    parsed = JSON.parse(text);
+  } catch (error) {
+    fail(path, `not valid JSON: ${error.message}`);
+  }
+  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) fail(path, "must be a JSON object");
+  const scopes = new Map();
+  for (const [scope, value] of Object.entries(parsed)) {
+    if (typeof value !== "object" || value === null || Array.isArray(value)) fail(path, `"${scope}" must be an object`);
+    for (const key of Object.keys(value)) {
+      if (!ALLOWED_KEYS.has(key)) fail(path, `"${scope}" has the unknown key "${key}"`);
+    }
+    if ("gh" in value && (typeof value.gh !== "string" || !value.gh)) fail(path, `"${scope}".gh must be a non-empty string`);
+    if ("reviewers" in value && !Array.isArray(value.reviewers)) fail(path, `"${scope}".reviewers must be a list`);
+    if ("mergeWithoutApproval" in value && typeof value.mergeWithoutApproval !== "boolean") {
+      fail(path, `"${scope}".mergeWithoutApproval must be true or false`);
+    }
+    scopes.set(scope.toLowerCase(), {
+      gh: value.gh,
+      mergeWithoutApproval: value.mergeWithoutApproval,
+      reviewers: (value.reviewers ?? []).map((rule, index) => reviewer(path, `"${scope}".reviewers[${index}]`, rule)),
+    });
+  }
+  return scopes;
+}
+
+/**
+ * Settings for one repository. The most specific `gh` and
+ * `mergeWithoutApproval` win: repository, then owner, then `*`. Reviewer rules
+ * add up across `*`, owner, and repo.
+ */
+export function settingsFor(scopes, owner, repo) {
+  const matching = ["*", owner, `${owner}/${repo}`].map((scope) => scopes.get(scope.toLowerCase())).filter(Boolean);
+  return {
+    gh: matching.map((scope) => scope.gh).filter(Boolean).at(-1) ?? null,
+    mergeWithoutApproval: matching.map((scope) => scope.mergeWithoutApproval).filter((value) => value !== undefined).at(-1) ?? false,
+    reviewers: matching.flatMap((scope) => scope.reviewers),
+  };
+}
+
+/**
+ * Resolves the GitHub CLI executable and its provenance description for a repository.
+ * Precedence: `WATCH_PR_GH` env var > repo/owner/`*` config `gh` > `"gh"`.
+ */
+export function resolveGitHubCli(settings, { env = process.env, settingsPath = configPath(env) } = {}) {
+  const executable = env.WATCH_PR_GH || settings.gh || "gh";
+  const source = env.WATCH_PR_GH
+    ? "WATCH_PR_GH"
+    : settings.gh
+      ? settingsPath
+      : `the default; none is set in WATCH_PR_GH or ${settingsPath}`;
+  return { executable, source };
+}
+
+/** Reads the `origin` remote URL of `cwd`, or returns `""` if unavailable. */
+export function originRemote(cwd = process.cwd()) {
+  return new Promise((resolve) => {
+    execFile("git", ["remote", "get-url", "origin"], { cwd }, (error, stdout) => resolve(error ? "" : stdout.trim()));
+  });
+}
+
+/** Extracts `{ owner, repo }` from a GitHub HTTPS or SSH remote URL. */
+export function parseGitHubRepoUrl(remote) {
+  const match = /github\.com[:/]([^/]+)\/([^/]+?)(?:\.git)?$/.exec(remote ?? "");
+  return match ? { owner: match[1], repo: match[2] } : null;
+}
+
+/**
+ * Resolves `{ owner, repo }` from CLI `--owner`/`--repo` flags or the git `origin` remote.
+ * Returns `null` if neither provides a complete GitHub repository identity.
+ */
+export async function resolveRepo({ owner, repo, cwd = process.cwd() } = {}) {
+  let resolvedOwner = owner;
+  let resolvedRepo = repo;
+  if (resolvedRepo?.includes("/")) {
+    const parts = resolvedRepo.split("/");
+    if (parts.length !== 2 || !parts[0] || !parts[1]) return null;
+    [resolvedOwner, resolvedRepo] = parts;
+  }
+  if (!resolvedOwner || !resolvedRepo) {
+    const origin = parseGitHubRepoUrl(await originRemote(cwd));
+    resolvedOwner ??= origin?.owner;
+    resolvedRepo ??= origin?.repo;
+  }
+  if (!resolvedOwner || !resolvedRepo) return null;
+  return { owner: resolvedOwner, repo: resolvedRepo };
+}
+
+/** Parses a PR URL or number (`123`, `#123`) into `{ owner, repo, number }`. */
+export async function parsePrTarget(target, { owner, repo, cwd = process.cwd() } = {}) {
+  let parsedOwner = owner;
+  let parsedRepo = repo;
+  let number = String(target).replace(/^#/, "");
+  const url = /^https:\/\/github\.com\/([^/]+)\/([^/]+)\/pull\/(\d+)/.exec(target);
+  if (url) [, parsedOwner, parsedRepo, number] = url;
+  if (!/^[1-9]\d*$/.test(number)) return { error: `not a pull request number or URL: ${target}` };
+  const resolved = await resolveRepo({ owner: parsedOwner, repo: parsedRepo, cwd });
+  if (!resolved) return { error: "name the repository: --repo OWNER/NAME" };
+  return { pr: { owner: resolved.owner, repo: resolved.repo, number: Number(number) } };
+}
diff --git a/skills/watch-pr/scripts/threads.mjs b/skills/watch-pr/scripts/threads.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..d8a204314d546845901a8da035da8e3c0fc02a24
--- /dev/null
+++ b/skills/watch-pr/scripts/threads.mjs
@@ -0,0 +1,158 @@
+// Review thread normalization, severity tag parsing, and formatting shared by
+// `github.mjs`, `verdict.mjs`, and `pr-threads.mjs`.
+
+export const SEVERITY_TAGS = Object.freeze([
+  "blocks",
+  "fix-if-cheap",
+  "next-action",
+  "critical",
+  "high",
+  "medium",
+  "low",
+  "nit",
+]);
+
+const TAG_ALT = SEVERITY_TAGS.join("|");
+const EXPLICIT_LABEL = new RegExp(
+  `(?:^|[\\s(\\[*_>])(?:severity|priority|level|class|verdict|category|tag)[*_\`\\s]{0,8}[:=][*_\`\\[\\]()\\s]{0,8}(${TAG_ALT})(?![a-z0-9-])`,
+  "i",
+);
+const BRACKET_TAG = new RegExp(`\\[(${TAG_ALT})\\]`, "i");
+const LINE_START_MARKUP = new RegExp(
+  `^[^\\w\\n]{0,24}(?:\\*\\*|__|\`)\\s*(${TAG_ALT})(?![a-z0-9-])\\s*(?:[:—–\\-|]|(?:\\*\\*|__|\`)(?:\\s*[:—–\\-|]|\\s|$))`,
+  "im",
+);
+const LINE_START_COLON = new RegExp(
+  `^[^\\w\\n]{0,24}(${TAG_ALT})\\s*:`,
+  "im",
+);
+const COMPOUND_TAG = /(?:`|\*\*|__)(fix-if-cheap|next-action)(?:`|\*\*|__)/i;
+
+const clip = (text, max) => (text.length > max ? `${text.slice(0, max - 1)}…` : text);
+
+/** Strips HTML comments and tags and collapses whitespace for single-line display. */
+export function cleanSnippet(body, maxLength = 200) {
+  const cleaned = (body ?? "")
+    .replace(/<!--[\s\S]*?-->/g, "")
+    .replace(/<[^>]*>/g, "")
+    .replace(/\s+/g, " ")
+    .trim();
+  return clip(cleaned, maxLength);
+}
+
+/**
+ * Extracts a TARS, Greptile, or Cursor severity tag from comment markdown/HTML.
+ * Matches structured labels/prefixes rather than arbitrary prose words.
+ *
+ * @param {string} body
+ * @returns {string | null}
+ */
+export function parseSeverity(body) {
+  if (!body) return null;
+  const plain = body
+    .replace(/<!--[\s\S]*?-->/g, "")
+    .replace(/<\/?(?:b|strong)\b[^>]*>/gi, "**")
+    .replace(/<[^>]*>/g, "");
+  for (const pattern of [EXPLICIT_LABEL, BRACKET_TAG, LINE_START_MARKUP, LINE_START_COLON, COMPOUND_TAG]) {
+    const match = pattern.exec(plain);
+    if (match?.[1]) return match[1].toLowerCase();
+  }
+  return null;
+}
+
+function sameCommit(a, b) {
+  if (!a || !b) return false;
+  const left = a.toLowerCase();
+  const right = b.toLowerCase();
+  return left.startsWith(right) || right.startsWith(left);
+}
+
+/**
+ * Normalizes a GraphQL `PullRequestReviewThread` node into a flat record with
+ * commit SHA, head comparison, parsed severity, and comment metadata.
+ */
+export function normalizeThread(node, headSha = null) {
+  const rawComments = node.comments?.nodes ?? [];
+  const comments = rawComments.map((comment) => ({
+    id: comment.id ?? null,
+    databaseId: comment.fullDatabaseId ?? comment.databaseId ?? null,
+    commit: comment.commit?.oid ?? null,
+    originalCommit: comment.originalCommit?.oid ?? null,
+    author: comment.author?.login ?? null,
+    body: comment.body ?? "",
+    url: comment.url ?? null,
+    createdAt: comment.createdAt ?? null,
+    isOutdated: Boolean(comment.outdated ?? comment.isOutdated ?? false),
+  }));
+  const first = comments[0];
+  // Prefer originalCommit so an un-rebased comment still shows the commit it
+  // was authored on rather than a newer commit the diff hunk slid onto.
+  const commitOid = first?.originalCommit ?? first?.commit ?? null;
+  let severity = null;
+  for (const comment of comments) {
+    severity = parseSeverity(comment.body);
+    if (severity) break;
+  }
+  return {
+    id: node.id ?? null,
+    isResolved: Boolean(node.isResolved),
+    isOutdated: Boolean(node.isOutdated ?? first?.isOutdated ?? false),
+    path: node.path ?? null,
+    line: node.line ?? node.originalLine ?? null,
+    author: first?.author ?? null,
+    body: first?.body ?? "",
+    url: first?.url ?? null,
+    createdAt: first?.createdAt ?? null,
+    commentId: first?.id ?? null,
+    databaseId: first?.databaseId ?? null,
+    commit: first?.commit ?? null,
+    originalCommit: first?.originalCommit ?? null,
+    commitOid,
+    shortCommit: commitOid ? commitOid.slice(0, 7) : null,
+    onHead: sameCommit(commitOid, headSha),
+    severity,
+    commentCount: comments.length,
+    comments,
+  };
+}
+
+/**
+ * Formats one unresolved thread line for `watch-pr`'s compact 20-line verdict block.
+ * Keeps metadata concise: `[<sha> head|older, <severity>]` when present.
+ */
+export function formatVerdictThread(thread, maxExcerpt = 200) {
+  const tags = [];
+  if (thread.shortCommit) tags.push(`${thread.shortCommit} ${thread.onHead ? "head" : "older"}`);
+  if (thread.severity) tags.push(thread.severity);
+  const meta = tags.length ? ` [${tags.join(", ")}]` : "";
+  return `  ${thread.path ?? "(no file)"}:${thread.line ?? "?"} @${thread.author ?? "unknown"}${meta}: ${cleanSnippet(thread.body, maxExcerpt)}`;
+}
+
+/** Formats the detailed thread list for `pr-threads.mjs --list`. */
+export function formatThreadList({ url, head, threads, includeResolved = false }) {
+  const lines = [
+    `pr: ${url}`,
+    `head: ${head}`,
+    `${includeResolved ? "threads" : "unresolved threads"}: ${threads.length}`,
+  ];
+  for (const thread of threads) {
+    const location = `${thread.path ?? "(no file)"}:${thread.line ?? "?"}`;
+    const commitLabel = thread.shortCommit
+      ? `${thread.shortCommit} (${thread.onHead ? "head" : "older"}${thread.isOutdated ? ", outdated" : ""})`
+      : thread.isOutdated ? "(outdated)" : "(no commit)";
+    const parts = [
+      thread.id ?? "(no id)",
+      location,
+      `@${thread.author ?? "unknown"}`,
+      commitLabel,
+    ];
+    if (thread.severity) parts.push(`[${thread.severity}]`);
+    if (includeResolved && thread.isResolved) parts.push("[resolved]");
+    if (thread.commentCount > 1) parts.push(`(${thread.commentCount} comments)`);
+    lines.push("");
+    lines.push(parts.join("  "));
+    if (thread.url) lines.push(`  url: ${thread.url}`);
+    lines.push(`  snippet: ${cleanSnippet(thread.body, 240)}`);
+  }
+  return `${lines.join("\n")}\n`;
+}
